# ── Supabase ────────────────────────────────────────────────────────────────
# 本地开发 / Vercel 部署：填你自己 Supabase 项目的值
# Project Settings → API → Project URL / anon public
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 可选：业务时区，影响 admin 端「今日已审」的日期边界。默认 Asia/Shanghai
# APP_TIME_ZONE=Asia/Shanghai

# 可选：PostgREST 暴露的 schema 名。默认 public（自建 Supabase 项目就是这个），
# 一般不需要填。只有当你的托管环境把表放在别的 schema 下时才需要指定。
# NEXT_PUBLIC_SUPABASE_SCHEMA=

# 可选：QW Pages 托管运行时会注入下面这三个变量（名字不同，不带 NEXT_PUBLIC_ 前缀）。
# lib/supabase/env.ts 会自动回退读取它们，并用 SUPABASE_INSTANCE_ID 推导出
# tenant_<instanceId>_schema 作为 schema，因此在 QW Pages 上无需重复配置。
# 不要把 service_role key 写进任何环境变量：本项目全程只用 anon key + RLS。
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_INSTANCE_ID=
